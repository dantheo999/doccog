# --- Azure OpenAI (LangExtract, Direct LLM, schema suggestion) ---
# Resource URL or full Azure OpenAI v1 base URL. No api-version parameter.
# Example: https://your-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=
# Your deployment name, which can differ from the underlying GPT model name.
AZURE_OPENAI_DEPLOYMENT=
# Keep this value in your local .env only, never in the frontend or source control.
AZURE_OPENAI_API_KEY=

# --- NuExtract3 (local OpenAI-compatible server) ---
# Compose runs llama.cpp as the "nuextract" service: leave this as is for Docker (it can point
# at a vLLM GPU server instead). .env is read only by docker compose; for local npm development
# set NUEXTRACT_BASE_URL in the shell that runs uvicorn instead, e.g.
# $env:NUEXTRACT_BASE_URL = "http://127.0.0.1:8090/v1"
NUEXTRACT_BASE_URL=http://nuextract:8080/v1
NUEXTRACT_MODEL=numind/NuExtract3
# CPU threads for llama.cpp (cores you can dedicate) and a memory cap for its container.
NUEXTRACT_THREADS=4
NUEXTRACT_MEM_LIMIT=8g

# --- Unstract (its own packaged platform, run separately) ---
# Browser URL of the Unstract UI that the landing page opens (default http://frontend.unstract.localhost).
UNSTRACT_UI_URL=
# API deployment endpoint and key, e.g. http://host.docker.internal:8000/deployment/api/<org_id>/<api_name>/
# (use localhost:8000 when the backend runs outside Docker; port 80 only routes the UI hostname).
UNSTRACT_API_URL=
UNSTRACT_API_KEY=
# Optional extra origins a run may target with the API key (comma-separated).
UNSTRACT_ALLOWED_ORIGINS=

# Browser port for the workbench (8080 is used by a local Unstract platform).
HOST_PORT=8088
